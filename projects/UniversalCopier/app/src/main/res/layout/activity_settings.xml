<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textSize="22sp"
            android:textStyle="bold"
            android:paddingBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_section_theme"
            android:textStyle="bold"
            android:paddingTop="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_theme"
            android:paddingTop="6dp" />

        <Spinner
            android:id="@+id/themeSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_section_modes"
            android:textStyle="bold"
            android:paddingTop="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_default_mode"
            android:paddingTop="6dp" />

        <Spinner
            android:id="@+id/defaultModeSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_section_behavior"
            android:textStyle="bold"
            android:paddingTop="8dp" />

        <CheckBox
            android:id="@+id/cbAutoCopy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_auto_copy" />

        <CheckBox
            android:id="@+id/cbAutoSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_auto_save" />

        <CheckBox
            android:id="@+id/cbOpenResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_open_result"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_section_memory"
            android:textStyle="bold"
            android:paddingTop="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_history_limit"
            android:paddingTop="6dp" />

        <Spinner
            android:id="@+id/historyLimitSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnClearHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_clear_all"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_section_system"
            android:textStyle="bold"
            android:paddingTop="8dp" />

        <Button
            android:id="@+id/btnSysAccessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_open_accessibility"
            android:layout_marginTop="6dp" />

        <Button
            android:id="@+id/btnSysOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_open_overlay"
            android:layout_marginTop="6dp" />

        <Button
            android:id="@+id/btnSysNotifications"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_open_notifications"
            android:layout_marginTop="6dp" />

        <Button
            android:id="@+id/btnSysBattery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_open_battery"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/about_title"
            android:textStyle="bold"
            android:textSize="16sp"
            android:paddingTop="8dp"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/about_desc"
            android:textSize="13sp"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/about_developer"
            android:textSize="13sp"
            android:paddingBottom="2dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/about_rights"
            android:textSize="13sp"
            android:paddingBottom="6dp" />

        <TextView
            android:id="@+id/aboutSite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/about_site"
            android:autoLink="web"
            android:linksClickable="true"
            android:textSize="13sp"
            android:paddingBottom="2dp" />

        <TextView
            android:id="@+id/aboutYoutube"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/about_youtube"
            android:autoLink="web"
            android:linksClickable="true"
            android:textSize="13sp"
            android:paddingBottom="2dp" />

        <TextView
            android:id="@+id/aboutTelegram"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/about_telegram"
            android:autoLink="web"
            android:linksClickable="true"
            android:textSize="13sp"
            android:paddingBottom="8dp" />

    </LinearLayout>
</ScrollView>
