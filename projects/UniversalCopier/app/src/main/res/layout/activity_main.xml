<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/main_title"
            android:textSize="26sp"
            android:textStyle="bold"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/main_subtitle"
            android:textSize="13sp"
            android:paddingBottom="12dp" />

        <TextView
            android:id="@+id/statusAccessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/status_accessibility_off"
            android:textSize="14sp"
            android:paddingBottom="2dp" />

        <TextView
            android:id="@+id/statusOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/status_overlay_off"
            android:textSize="14sp"
            android:paddingBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/mode_label"
            android:textStyle="bold"
            android:paddingBottom="4dp" />

        <Spinner
            android:id="@+id/modeSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnStartOverlay"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_start_overlay"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnStopOverlay"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_stop_overlay" />
        </LinearLayout>

        <Button
            android:id="@+id/btnCopyUiNow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_copy_ui_now"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btnScanScreen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_scan_screen"
            android:layout_marginTop="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btnQuickClipboard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_quick_clipboard"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnHistory"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_history" />
        </LinearLayout>

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_settings"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="إعدادات نظامية سريعة"
            android:textStyle="bold"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />

        <Button
            android:id="@+id/btnAccessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_enable_accessibility"
            android:layout_marginBottom="6dp" />

        <Button
            android:id="@+id/btnOverlayPermission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_overlay_permission"
            android:layout_marginBottom="6dp" />

        <Button
            android:id="@+id/btnNotificationSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_notification_settings"
            android:layout_marginBottom="6dp" />

        <Button
            android:id="@+id/btnBatterySettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_battery_settings"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hint_usage"
            android:textSize="13sp"
            android:lineSpacingExtra="2dp" />

    </LinearLayout>
</ScrollView>
